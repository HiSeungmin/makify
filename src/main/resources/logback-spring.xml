<!--        </rollingPolicy>-->
<!--    </appender>-->

    <!-- Data 로그 파일 Appender (추후 데이터 수집용) -->
    <appender name="DATA_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE_PATH}/data.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %msg%n</pattern>
            <charset>utf8</charset>
        </encoder>
        <!-- 날짜별 롤링 정책만 사용 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE_PATH}/data-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- AOP 로깅용 전용 로거 -->
    <logger name="com.xladmt.makify.common.aop" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APPLICATION_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- Service 레이어 로거 -->
    <logger name="com.xladmt.makify.payment.service" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APPLICATION_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <logger name="com.xladmt.makify.member.service" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APPLICATION_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <logger name="com.xladmt.makify.challenge.service" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APPLICATION_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- Facade 레이어 로거 -->
    <logger name="com.xladmt.makify.application" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APPLICATION_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- Controller 레이어 로거 -->
    <logger name="com.xladmt.makify.payment.controller" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APPLICATION_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <logger name="com.xladmt.makify.member.controller" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APPLICATION_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- 검색 로거 (data.log에만 기록) -->
    <logger name="search" level="INFO" additivity="false">
        <appender-ref ref="DATA_FILE"/>
    </logger>

    <!-- Hibernate SQL 로그 (비활성화 - 원치 않으면 주석 처리) -->
    <!-- SQL 로그를 남기고 싶으면 아래 주석을 제거하세요
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
        <appender-ref ref="APPLICATION_FILE"/>
    </logger>

    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE" additivity="false">
        <appender-ref ref="APPLICATION_FILE"/>
    </logger>
    -->

    <!-- Spring 프레임워크 로그 -->
    <logger name="org.springframework" level="INFO" additivity="false">
        <appender-ref ref="APPLICATION_FILE"/>
    </logger>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APPLICATION_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
